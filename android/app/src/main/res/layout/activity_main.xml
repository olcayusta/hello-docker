<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E2E8F0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:textColorHint="#64748B"
                android:textColor="#E2E8F0"
                android:background="#1E293B"
                android:padding="10dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/search_button" />
        </LinearLayout>

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_hint"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/radiusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CBD5E1"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/radiusSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1980"
            android:progress="180"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/targetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/target_not_set"
            android:textColor="#CBD5E1"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/start_tracking" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/stop_tracking" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:text="@string/status_idle"
            android:textColor="#93C5FD"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/backgroundLocationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_background_location_title"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_background_location_body"
                android:textColor="#FECACA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/openLocationSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/approximateLocationWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/approximate_location_warning"
            android:textColor="#FCD34D"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/fullScreenIntentWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/full_screen_intent_warning"
            android:textColor="#FCD34D"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/batteryOptimizationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_optimization_hint"
                android:textColor="#94A3B8"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/disableBatteryOptimizationButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disable_battery_optimization" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
